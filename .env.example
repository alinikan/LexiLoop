# Account mode is the default. Production always disables the device demo.
NEXT_PUBLIC_DEMO_MODE=false
MOCK_AI=false
AI_PROVIDER=openai
NEXT_PUBLIC_APP_URL=http://localhost:3000
# Required for real accounts (demo=false).
NEXT_PUBLIC_SUPABASE_URL=
NEXT_PUBLIC_SUPABASE_PUBLISHABLE_KEY=
# Server only. Used after auth verification for atomic state commits / lexical cache.
SUPABASE_SECRET_KEY=
# Used only by migration/seed CLI. Get a Supabase connection string.
DATABASE_URL=
# Required when AI_PROVIDER=openai and MOCK_AI=false.
OPENAI_API_KEY=
OPENAI_MODEL=gpt-4.1-mini

# Optional licensed Cambridge API. Leave blank for the external-link fallback.
CAMBRIDGE_API_KEY=
CAMBRIDGE_DICTIONARY_CODE=
CAMBRIDGE_LICENSE_CONFIRMED=false
# Enable only if your Cambridge agreement permits audio playback.
CAMBRIDGE_AUDIO_LICENSE_CONFIRMED=false
