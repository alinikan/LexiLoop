# Normal setup: real accounts and server-side OpenAI generation.
# For a local preview without accounts or paid API calls, use npm run dev:demo.
NEXT_PUBLIC_DEMO_MODE=false
MOCK_AI=false
AI_PROVIDER=openai
# Keep localhost here; use https://lexiloop-ali.vercel.app in Vercel Production.
NEXT_PUBLIC_APP_URL=http://localhost:3000
# Browser-safe Supabase project configuration.
NEXT_PUBLIC_SUPABASE_URL=
NEXT_PUBLIC_SUPABASE_PUBLISHABLE_KEY=
# Privileged server credential. Never expose to the browser.
SUPABASE_SECRET_KEY=
# Local migration/seed scripts only; not required in Vercel runtime.
DATABASE_URL=
# Server-side API key. API usage is billed separately from ChatGPT.
OPENAI_API_KEY=
OPENAI_MODEL=gpt-5.6-terra

# Optional licensed Cambridge API. Leave blank for the external-link fallback.
CAMBRIDGE_API_KEY=
CAMBRIDGE_DICTIONARY_CODE=
CAMBRIDGE_LICENSE_CONFIRMED=false
# Enable only if your Cambridge agreement permits audio playback.
CAMBRIDGE_AUDIO_LICENSE_CONFIRMED=false
