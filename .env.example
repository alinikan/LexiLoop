# Normal setup: real accounts and server-side OpenAI generation.
# For a local preview without accounts or paid API calls, use npm run dev:demo.
NEXT_PUBLIC_DEMO_MODE=false
MOCK_AI=false
AI_PROVIDER=openai
# Keep localhost here; use https://lexiloop-ali.vercel.app in Vercel Production.
NEXT_PUBLIC_APP_URL=http://localhost:3000
# Browser-safe Supabase project configuration.
NEXT_PUBLIC_SUPABASE_URL=
NEXT_PUBLIC_SUPABASE_PUBLISHABLE_KEY=
# Privileged server credential. Never expose to the browser.
SUPABASE_SECRET_KEY=
# Local migration/seed scripts only; not required in Vercel runtime.
DATABASE_URL=
# Server-side API key. API usage is billed separately from ChatGPT.
OPENAI_API_KEY=
OPENAI_MODEL=gpt-5.6-terra

# Private account dashboard. Comma-separate more than one administrator.
ADMIN_EMAILS=you@example.com
# Confirmed-signup alerts through Resend. These values stay server-side.
RESEND_API_KEY=
SIGNUP_NOTIFICATION_TO=you@example.com
SIGNUP_NOTIFICATION_FROM=LexiLoop <notifications@your-domain.example>
# Generate at least 32 random bytes; use the same value in the Supabase Database Webhook header.
SIGNUP_WEBHOOK_SECRET=
